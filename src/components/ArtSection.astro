---
import { containerClass } from '@/data/layout';

const items = [
  'Rehabilitación motora, respiratoria y neurológica',
  'Psicoterapia, evaluación y psicodiagnóstico',
  'Consultas traumatológicas y médicas de todas las especialidades',
  'Enfermería domiciliaria para curaciones y antibióticos',
  'Laboratorio de análisis clínicos a domicilio',
  'Servicio de radiología (RX) a domicilio',
  'Cadetería de medicamentos y notificaciones',
  'Atención de pacientes crónicos (Res. SRT 180/2015)',
];
---

<section id="art" class="scroll-mt-(--header-height) bg-white py-16 sm:py-20 lg:py-24" aria-labelledby="art-titulo">
  <div class={containerClass}>
    <h2 id="art-titulo" class="text-3xl font-bold tracking-tight text-red sm:text-4xl" data-aos="fade-up">
      Servicios para ART
    </h2>
    <p class="mt-3 max-w-4xl text-base text-red sm:text-lg" data-aos="fade-up" data-aos-delay="100">
      Cuidamos a las personas. Protegemos a las empresas.
      <br />
      Modelo de atención domiciliaria descentralizado, ágil y eficiente que reduce tiempos, costos y riesgos de
      traslado.
    </p>

    <div class="mt-10 grid items-start gap-6 sm:grid-cols-[1fr_450px] lg:grid-cols-[450px_1fr] lg:gap-8">
      <img
        src="/images/ART/servicios-art.webp"
        alt="Lupa sobre un escudo de protección laboral, con íconos de prevención, salud y cobertura para ART."
        class="h-full w-full rounded-2xl object-cover"
        loading="lazy"
        decoding="async"
        data-aos="fade-up"
      />

      <article class="flex flex-col overflow-hidden rounded-2xl" data-aos="fade-up" data-aos-delay="100">
        <h3 class="bg-red px-5 py-3 text-sm font-semibold text-white sm:px-6 sm:py-3.5 lg:text-base">
          Prestaciones domiciliarias para ART
        </h3>
        <div class="flex-1 bg-cream px-5 py-4 sm:px-6 sm:py-5">
          <ul class="list-disc space-y-1 pl-5 text-sm leading-relaxed text-hero-filter lg:text-base">
            {items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </article>
    </div>
  </div>
</section>
