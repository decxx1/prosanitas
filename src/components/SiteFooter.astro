---
import { Icon } from 'astro-icon/components';
import {
  CONTACT_EMAIL,
  CONTACT_PHONE_OPERATIONS,
  CONTACT_PHONE_ADMINISTRATION,
  CONTACT_ADDRESS,
  CONTACT_FACEBOOK_LABEL,
  CONTACT_INSTAGRAM_LABEL,
  SOCIAL_FACEBOOK_URL,
  SOCIAL_INSTAGRAM_URL,
  SOCIAL_WHATSAPP_URL,
} from 'astro:env/client';
import { containerClass } from '@/data/layout';
import ContactForm from '@/components/ContactForm.astro';

const socialContacts = [
  { label: CONTACT_FACEBOOK_LABEL, href: SOCIAL_FACEBOOK_URL, icon: 'qlementine-icons:facebook-16' },
  { label: CONTACT_INSTAGRAM_LABEL, href: SOCIAL_INSTAGRAM_URL, icon: 'mdi:instagram' },
];
const phoneHref = (phone: string) => `tel:${phone.replace(/[^\d+]/g, '')}`;
---

<footer id="contacto" class="scroll-mt-(--header-height)">
  <div class="bg-hero-filter py-12 text-white sm:py-16">
    <div class={containerClass}>
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] lg:gap-16">
        <section aria-labelledby="footer-contactos-titulo">
          <h2 id="footer-contactos-titulo" class="text-3xl font-bold leading-tight">Contactos</h2>
          <ul class="mt-5 space-y-2 text-base leading-snug sm:text-lg">
            {socialContacts.map((contact) => contact.label && (
              <li class="flex items-center gap-2">
                <Icon name={contact.icon} class="size-7 shrink-0" aria-hidden="true" />
                {contact.href ? (
                  <a href={contact.href} target="_blank" rel="noopener noreferrer" class="wrap-break-word hover:underline">{contact.label}</a>
                ) : <span>{contact.label}</span>}
              </li>
            ))}
            {CONTACT_EMAIL && (
              <li class="flex items-center gap-2">
                <Icon name="mdi:email-outline" class="size-7 shrink-0" aria-hidden="true" />
                <a href={`mailto:${CONTACT_EMAIL}`} class="break-all hover:underline">{CONTACT_EMAIL}</a>
              </li>
            )}
            {(CONTACT_PHONE_OPERATIONS || CONTACT_PHONE_ADMINISTRATION) && (
              <li class="flex items-start gap-2">
                <Icon name="mdi:whatsapp" class="size-7 shrink-0" aria-hidden="true" />
                <span>
                  {CONTACT_PHONE_OPERATIONS && (
                    <a href={SOCIAL_WHATSAPP_URL || phoneHref(CONTACT_PHONE_OPERATIONS)} class="hover:underline">
                      {CONTACT_PHONE_OPERATIONS} (Operaciones)
                    </a>
                  )}
                  {CONTACT_PHONE_OPERATIONS && CONTACT_PHONE_ADMINISTRATION && ' | '}
                  {CONTACT_PHONE_ADMINISTRATION && (
                    <a href={phoneHref(CONTACT_PHONE_ADMINISTRATION)} class="hover:underline">
                      {CONTACT_PHONE_ADMINISTRATION} (Administración)
                    </a>
                  )}
                </span>
              </li>
            )}
            {CONTACT_ADDRESS && (
              <li class="flex items-start gap-2">
                <Icon name="mdi:map-marker-outline" class="size-7 shrink-0" aria-hidden="true" />
                <address class="not-italic">{CONTACT_ADDRESS}</address>
              </li>
            )}
          </ul>
        </section>

        <section aria-labelledby="footer-formulario-titulo">
          <h2 id="footer-formulario-titulo" class="text-3xl font-bold leading-tight">Escribinos</h2>
          <ContactForm />
        </section>
      </div>

      <a href="/" aria-label="Prosanitas, inicio" class="mx-auto mt-16 block w-full max-w-2xl sm:mt-20">
        <img src="/images/logos/prosanitas-blanco.svg" alt="Prosanitas" class="h-auto w-full" loading="lazy" />
      </a>
    </div>
  </div>
  <div class="bg-white px-5 py-9 text-center text-base text-neutral-600 sm:py-10 sm:text-lg">
    Desarrollado por <a href="https://tresvecestres.com.ar/" target="_blank" rel="noopener noreferrer" class="font-bold hover:underline">Tres Veces Tres</a>
  </div>
</footer>
