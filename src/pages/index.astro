---
import AboutSection from '@/components/AboutSection.astro';
import ArtSection from '@/components/ArtSection.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CadeidCta from '@/components/CadeidCta.astro';
import CompanySection from '@/components/CompanySection.astro';
import ContactCta from '@/components/ContactCta.astro';
import HeroCarousel from '@/components/HeroCarousel.astro';
import ServicesSection from '@/components/ServicesSection.astro';

const title = 'Prosanitas Salud | Cuidamos tu bienestar';
const metaDescription =
  'Soluciones médicas integrales para el hogar, las empresas y las ART. Innovando en la forma de cuidar tu salud.';
---

<BaseLayout
  {title}
  {metaDescription}
  canonical="/"
  fullImg="/images/hero/soluciones-medicas.webp"
  twitterCard="summary_large_image"
  preLoad={[
    { href: '/images/hero/soluciones-medicas.webp', as: 'image', type: 'image/webp' },
    { href: '/images/logos/prosanitas-cyan.svg', as: 'image', type: 'image/svg+xml' },
  ]}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Prosanitas Salud',
    url: 'https://prosanitassalud.com.ar',
    logo: 'https://prosanitassalud.com.ar/images/logos/favicon/favicon.svg',
  }}
>
  <main id="contenido">
    <HeroCarousel />
    <AboutSection />
    <ServicesSection />
    <CompanySection />
    <ArtSection />
    <CadeidCta />
    <ContactCta />
  </main>
</BaseLayout>
